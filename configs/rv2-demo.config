# Fault injection: LKDTM, the kernel's own deliberately-buggy test code.
# A kernel with this fragment is built to be guilty — the memdebug job
# triggers a real use-after-free through /sys/kernel/debug/provoke-crash/
# DIRECT and dmesg-clean goes red, proving the detectors fire. Demo only,
# NEVER a regression run. LKDTM lives under RUNTIME_TESTING_MENU, which
# defconfigs may disable, so both are set.
CONFIG_RUNTIME_TESTING_MENU=y
CONFIG_LKDTM=y
