# Orange Pi RV2 (SpacemiT Ky X1 / K1) fragment, merged onto `make ARCH=riscv
# defconfig` by .github/workflows/rv2-kernel.yml (and usable locally with
# scripts/kconfig/merge_config.sh -m .config <this file> && make olddefconfig).
#
# Without the first five the kernel cannot bring up the SoC at all; the CI
# aborts if any of them is dropped by olddefconfig (a Kconfig dependency
# changed upstream — investigate before shipping such a kernel to the lab).
CONFIG_ARCH_SPACEMIT=y
CONFIG_SPACEMIT_K1_CCU=y
CONFIG_RESET_SPACEMIT_K1=y
CONFIG_PINCTRL_SPACEMIT_K1=y
CONFIG_GPIO_SPACEMIT_K1=y
# Needed for NFS-root jobs (EMAC + its PHY) and the PCIe work this lab exists
# for; ramdisk-only jobs boot without them.
CONFIG_SPACEMIT_K1_EMAC=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_PCIE_SPACEMIT_K1=y
CONFIG_PHY_SPACEMIT_K1_PCIE=y
CONFIG_PHY_SPACEMIT_K1_USB2=y
# The NVMe driver, built in because the lab ships no modules: riscv defconfig
# has it as =m, which left the M.2 SSD with no driver on the board. The
# memdebug job reads from the SSD after every suspend/resume cycle.
CONFIG_BLK_DEV_NVME=y
# The EEPROM that holds the Ethernet MAC addresses (ONIE TLV format). Since
# the 7.4 merge window the RV2 device tree points both Ethernet ports at it;
# without these drivers the kernel holds both ports back and may name the
# unplugged port eth0, which breaks NFS-root jobs (job 400).
CONFIG_EEPROM_AT24=y
CONFIG_NVMEM_LAYOUT_ONIE_TLV=y
