# Memory/concurrency bug detectors, layered on top of rv2.config for the
# rv2-debug channel (orangepi-rv2-memdebug.yaml boots this kernel).
# KASAN: use-after-free / out-of-bounds, reported at the faulting access.
# KFENCE: sampling KASAN, near-zero overhead. kmemleak: allocations nothing
# references anymore (needs an explicit scan — the memdebug job does two).
# PROVE_LOCKING / DEBUG_ATOMIC_SLEEP: deadlock potential, sleep-in-atomic.
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KFENCE=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=65536
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
